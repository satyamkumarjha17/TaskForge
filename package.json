{
  "name": "taskforge",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "typecheck": "npm --workspace server run typecheck && npm --workspace client run typecheck",
    "lint": "npm --workspace server run lint && npm --workspace client run lint",
    "test": "npm --workspace server run test && npm --workspace client run test",
    "db:generate": "npm --workspace server run db:generate",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:deploy": "npm --workspace server run db:deploy",
    "db:validate": "npm --workspace server run db:validate",
    "start": "npm --workspace server run start"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.19.1"
  },
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
